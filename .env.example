# Copy to .env and adjust. Every value is optional; the app runs with none of them.
# Never commit .env: it is listed in .gitignore.

# --- Upload and processing limits ---
DOCUBHARAT_MAX_UPLOAD_MB=10
DOCUBHARAT_MAX_PAGES=100
DOCUBHARAT_MIN_CHARS_PER_PAGE=40

# --- Chunking and retrieval ---
DOCUBHARAT_CHUNK_WORDS=500
DOCUBHARAT_CHUNK_OVERLAP_WORDS=50
DOCUBHARAT_TOP_K=4

# --- Optional hosted LLM (Phase 2) ---
# Leave LLM_API_KEY empty to run without AI (extractive answers only).
# Groq: create a free key at https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=
# Defaults for Groq; change both to use any other OpenAI-compatible endpoint (https only).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Rate limits asking for a longer wait than this are reported instead of waited out.
LLM_MAX_RETRY_WAIT_SECONDS=10
LLM_MAX_OUTPUT_TOKENS=1500
# Maximum document text sent per request, and passages sent per question.
LLM_MAX_CONTEXT_CHARS=9000
LLM_MAX_PASSAGES=3

# --- Optional local translation: AI4Bharat IndicTrans2 (CTranslate2, CPU) ---
# Needs: pip install -r requirements-translation.txt (see README) and the model,
# fetched once with: python scripts/setup_indictrans2.py
# HF_TOKEN (a read token from https://huggingface.co/settings/tokens) is used by that
# setup script (accept the terms of https://huggingface.co/datasets/ai4bharat/BPCC first)
# and to call your private Patram Space below (accept the Patram model's terms too).
HF_TOKEN=
TRANSLATION_ENABLED=true
# --- Optional: BharatGen Patram on your private Hugging Face ZeroGPU Space ---
# See docs/patram_space_plan.md. Format: <your-hf-username>/<space-name>
PATRAM_SPACE_ID=
PATRAM_ENABLED=true
# Pages sent for Patram summary/fields (each page = one GPU call)
PATRAM_MAX_PAGES=2
PATRAM_TIMEOUT_SECONDS=180
INDICTRANS2_MODEL_DIR=models/indictrans2-en-indic-dist
